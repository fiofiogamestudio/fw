{
  "root": "main",
  "templates": {
    "main": {
      "type": "stack",
      "children": [
        {
          "type": "heading",
          "text": {
            "$text": "title"
          }
        },
        {
          "type": "field",
          "ref": "asset",
          "testId": "fwv-spine-asset",
          "field": {
            "schemaPath": "spineDrafts[].data.assetId",
            "type": "select",
            "label": false
          },
          "attrs": {
            "disabled": {
              "$path": "busy",
              "default": false
            }
          },
          "visible": {
            "$path": "hasAsset",
            "default": false
          }
        },
        {
          "type": "details",
          "children": [
            {
              "type": "summary",
              "text": {
                "$text": "importHistory"
              }
            },
            {
              "type": "stack",
              "preset": "compact",
              "children": [
                {
                  "type": "field",
                  "ref": "revision",
                  "testId": "fwv-spine-revision",
                  "field": {
                    "schemaPath": "spineDrafts[].data.revisionId",
                    "type": "select"
                  },
                  "attrs": {
                    "disabled": {
                      "$path": "busy",
                      "default": false
                    }
                  },
                  "visible": {
                    "$path": "hasAsset",
                    "default": false
                  }
                },
                {
                  "type": "button",
                  "ref": "import",
                  "testId": "fwv-spine-import",
                  "text": {
                    "$text": "import"
                  },
                  "tone": {
                    "$if": [
                      {
                        "$path": "hasAsset",
                        "default": false
                      },
                      "default",
                      "primary"
                    ]
                  },
                  "on": {
                    "click": "dispatch"
                  },
                  "attrs": {
                    "disabled": {
                      "$path": "busy",
                      "default": false
                    }
                  }
                },
                {
                  "type": "field",
                  "ref": "import-input",
                  "testId": "fwv-spine-import-input",
                  "field": {
                    "type": "file",
                    "label": false
                  },
                  "attrs": {
                    "accept": ".json,.atlas,.png",
                    "multiple": true,
                    "disabled": {
                      "$path": "busy",
                      "default": false
                    }
                  },
                  "hidden": true
                },
                {
                  "type": "text",
                  "text": {
                    "$text": "intro"
                  },
                  "tone": "muted"
                }
              ]
            }
          ],
          "testId": "fwv-spine-history",
          "attrs": {
            "open": {
              "$not": {
                "$path": "hasAsset",
                "default": false
              }
            }
          }
        },
        {
          "type": "columns",
          "preset": "workspace",
          "children": [
            {
              "type": "stack",
              "preset": "compact",
              "children": [
                {
                  "type": "columns",
                  "ref": "views",
                  "preset": "comparison"
                },
                {
                  "type": "slot",
                  "ref": "transport"
                },
                {
                  "type": "text",
                  "ref": "preview-status",
                  "testId": "fwv-spine-preview-status",
                  "attrs": {
                    "role": "status",
                    "data-error": {
                      "$path": "previewError",
                      "default": false
                    }
                  },
                  "text": {
                    "$path": "previewStatus",
                    "default": ""
                  },
                  "tone": {
                    "$if": [
                      {
                        "$path": "previewError",
                        "default": false
                      },
                      "danger",
                      "default"
                    ]
                  },
                  "visible": {
                    "$path": "previewError"
                  }
                },
                {
                  "type": "details",
                  "children": [
                    {
                      "type": "summary",
                      "text": {
                        "$text": "checksExport"
                      }
                    },
                    {
                      "type": "stack",
                      "preset": "compact",
                      "children": [
                        {
                          "type": "toolbar",
                          "children": [
                            {
                              "type": "button",
                              "ref": "validate",
                              "testId": "fwv-spine-validate",
                              "text": {
                                "$text": "validate"
                              },
                              "on": {
                                "click": "dispatch"
                              },
                              "attrs": {
                                "disabled": {
                                  "$path": "busy",
                                  "default": false
                                }
                              }
                            },
                            {
                              "type": "button",
                              "ref": "export",
                              "testId": "fwv-spine-export",
                              "text": {
                                "$text": "export"
                              },
                              "on": {
                                "click": "dispatch"
                              },
                              "attrs": {
                                "disabled": {
                                  "$path": "busy",
                                  "default": false
                                }
                              }
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "ref": "issues",
                          "testId": "fwv-spine-issues",
                          "attrs": {
                            "role": "status"
                          },
                          "text": {
                            "$path": "issues",
                            "default": ""
                          },
                          "visible": {
                            "$path": "issues"
                          }
                        },
                        {
                          "type": "text",
                          "ref": "summary",
                          "tone": "muted",
                          "text": {
                            "$path": "summary",
                            "default": ""
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "stack",
              "preset": "compact",
              "children": [
                {
                  "type": "field",
                  "ref": "region",
                  "testId": "fwv-spine-region",
                  "field": {
                    "schemaPath": "spineDrafts[].data.regionName",
                    "type": "select",
                    "label": "当前部件"
                  },
                  "attrs": {
                    "disabled": {
                      "$path": "busy",
                      "default": false
                    }
                  }
                },
                {
                  "type": "stack",
                  "preset": [
                    "preview",
                    "overlay",
                    "thumbnail"
                  ],
                  "children": [
                    {
                      "type": "image",
                      "ref": "basePart",
                      "attrs": {
                        "alt": "原始部件轮廓",
                        "src": {
                          "$path": "originalPartUrl"
                        }
                      },
                      "tone": "muted",
                      "preset": "ghost"
                    },
                    {
                      "type": "image",
                      "ref": "currentPart",
                      "attrs": {
                        "alt": "当前部件",
                        "src": {
                          "$path": "currentPartUrl"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "button",
                  "ref": "choose",
                  "testId": "fwv-spine-choose",
                  "text": {
                    "$text": "choose"
                  },
                  "on": {
                    "click": "dispatch"
                  },
                  "attrs": {
                    "disabled": {
                      "$path": "busy",
                      "default": false
                    }
                  }
                },
                {
                  "type": "field",
                  "ref": "replacement-input",
                  "testId": "fwv-spine-replacement-input",
                  "field": {
                    "type": "file",
                    "label": false
                  },
                  "attrs": {
                    "accept": ".png,.jpg,.jpeg,.webp",
                    "multiple": false,
                    "disabled": {
                      "$path": "busy",
                      "default": false
                    }
                  },
                  "hidden": true
                },
                {
                  "type": "text",
                  "ref": "replaceName",
                  "text": {
                    "$path": "replacementName",
                    "default": {
                      "$text": "replacementEmpty"
                    }
                  },
                  "tone": "muted"
                },
                {
                  "type": "details",
                  "children": [
                    {
                      "type": "summary",
                      "text": {
                        "$text": "libraryHeading"
                      }
                    },
                    {
                      "type": "stack",
                      "preset": "compact",
                      "children": [
                        {
                          "type": "field",
                          "ref": "library-image",
                          "testId": "fwv-spine-library-image",
                          "field": {
                            "schemaPath": "spineDrafts[].data.libraryImageId",
                            "type": "select"
                          },
                          "attrs": {
                            "disabled": {
                              "$path": "busy",
                              "default": false
                            }
                          }
                        },
                        {
                          "type": "button",
                          "ref": "use-library",
                          "testId": "fwv-spine-use-library",
                          "text": {
                            "$text": "useLibrary"
                          },
                          "on": {
                            "click": "dispatch"
                          },
                          "attrs": {
                            "disabled": {
                              "$path": "busy",
                              "default": false
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "details",
                  "children": [
                    {
                      "type": "summary",
                      "text": {
                        "$text": "transformHeading"
                      }
                    },
                    {
                      "type": "stack",
                      "preset": "compact",
                      "children": [
                        {
                          "type": "columns",
                          "columns": 2,
                          "children": [
                            {
                              "type": "field",
                              "ref": "scale",
                              "testId": "fwv-spine-scale",
                              "field": {
                                "schemaPath": "spineDrafts[].data.transform.scale",
                                "type": "number"
                              },
                              "attrs": {
                                "disabled": {
                                  "$path": "busy",
                                  "default": false
                                }
                              },
                              "value": {
                                "$path": "transform.scale"
                              }
                            },
                            {
                              "type": "field",
                              "ref": "offsetX",
                              "testId": "fwv-spine-offsetX",
                              "field": {
                                "schemaPath": "spineDrafts[].data.transform.offsetX",
                                "type": "number"
                              },
                              "attrs": {
                                "disabled": {
                                  "$path": "busy",
                                  "default": false
                                }
                              },
                              "value": {
                                "$path": "transform.offsetX"
                              }
                            },
                            {
                              "type": "field",
                              "ref": "offsetY",
                              "testId": "fwv-spine-offsetY",
                              "field": {
                                "schemaPath": "spineDrafts[].data.transform.offsetY",
                                "type": "number"
                              },
                              "attrs": {
                                "disabled": {
                                  "$path": "busy",
                                  "default": false
                                }
                              },
                              "value": {
                                "$path": "transform.offsetY"
                              }
                            },
                            {
                              "type": "field",
                              "ref": "rotation",
                              "testId": "fwv-spine-rotation",
                              "field": {
                                "schemaPath": "spineDrafts[].data.transform.rotation",
                                "type": "number"
                              },
                              "attrs": {
                                "disabled": {
                                  "$path": "busy",
                                  "default": false
                                }
                              },
                              "value": {
                                "$path": "transform.rotation"
                              }
                            }
                          ]
                        },
                        {
                          "type": "field",
                          "ref": "flip",
                          "testId": "fwv-spine-flip",
                          "field": {
                            "schemaPath": "spineDrafts[].data.transform.flipX",
                            "type": "checkbox"
                          },
                          "attrs": {
                            "disabled": {
                              "$path": "busy",
                              "default": false
                            }
                          },
                          "value": {
                            "$path": "transform.flipX"
                          }
                        },
                        {
                          "type": "text",
                          "text": {
                            "$text": "partNote"
                          },
                          "tone": "muted"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "text",
                  "testId": "fwv-spine-calibration-status",
                  "attrs": {
                    "role": "status",
                    "data-state": {
                      "$if": [
                        {
                          "$path": "calibrationPending"
                        },
                        "pending",
                        {
                          "$if": [
                            {
                              "$path": "calibrationError"
                            },
                            "error",
                            "ready"
                          ]
                        }
                      ]
                    }
                  },
                  "text": {
                    "$path": "calibrationStatus",
                    "default": ""
                  },
                  "visible": {
                    "$path": "calibrationStatus"
                  },
                  "tone": {
                    "$if": [
                      {
                        "$path": "calibrationError"
                      },
                      "danger",
                      "muted"
                    ]
                  }
                },
                {
                  "type": "button",
                  "ref": "replace",
                  "testId": "fwv-spine-replace",
                  "text": {
                    "$text": "replace"
                  },
                  "tone": "primary",
                  "on": {
                    "click": "dispatch"
                  },
                  "attrs": {
                    "disabled": {
                      "$or": [
                        {
                          "$path": "busy"
                        },
                        {
                          "$not": {
                            "$path": "hasReplacement"
                          }
                        },
                        {
                          "$not": {
                            "$path": "hasAsset"
                          }
                        },
                        {
                          "$path": "calibrationPending"
                        },
                        {
                          "$path": "calibrationError"
                        }
                      ]
                    }
                  },
                  "visible": {
                    "$path": "hasAsset",
                    "default": false
                  }
                },
                {
                  "type": "button",
                  "ref": "clear",
                  "testId": "fwv-spine-clear",
                  "text": {
                    "$text": "clear"
                  },
                  "visible": {
                    "$path": "hasReplacement"
                  },
                  "attrs": {
                    "disabled": {
                      "$path": "busy",
                      "default": false
                    }
                  },
                  "on": {
                    "click": "dispatch"
                  }
                }
              ]
            }
          ],
          "visible": {
            "$path": "hasAsset",
            "default": false
          }
        },
        {
          "type": "text",
          "ref": "status",
          "testId": "fwv-spine-status",
          "attrs": {
            "role": "status",
            "data-error": {
              "$path": "noticeError",
              "default": false
            }
          },
          "text": {
            "$path": "notice",
            "default": {
              "$text": "ready"
            }
          },
          "tone": {
            "$if": [
              {
                "$path": "noticeError",
                "default": false
              },
              "danger",
              "default"
            ]
          },
          "visible": {
            "$path": "notice"
          }
        }
      ],
      "testId": "fwv-spine"
    }
  },
  "texts": {
    "title": "部件换皮",
    "intro": "选择 Spine 4.2 JSON、Atlas 和全部 PNG 文件。",
    "import": "导入 Spine",
    "previewHeading": "同步动画预览",
    "previewNote": "",
    "partHeading": "部件校准",
    "partNote": "淡色：原始轮廓",
    "choose": "选择替换图片",
    "replacementEmpty": "尚未选择图片",
    "useLibrary": "使用此图",
    "replace": "应用替换",
    "validate": "检查已保存版本",
    "export": "导出已保存版本",
    "saveNote": "",
