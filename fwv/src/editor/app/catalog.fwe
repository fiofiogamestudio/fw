id fwv-catalog
title "2D 美术素材"
source "fwv-catalog:."
file "catalog.json"

data Catalog {
  schemaVersion: int = 1 @readonly
  projectId: string @readonly
  images: ImageEntry[]
  assetOptions: CatalogOption[]
  kindOptions: CatalogOption[]
  versionOptions: CatalogOption[]
}

type CatalogOption {
  id: string @key @readonly
  name: string @readonly
}

type ImageEntry {
  id: string @key @readonly
  assetId: string @readonly
  revisionId: string @readonly
  file: string @readonly
  name: string @readonly @label("图片")
  assetName: string @readonly @label("所属素材")
  kind: string @readonly @label("素材类型")
  mime: string @readonly @label("格式")
  bytes: int @readonly @label("字节数")
  version: string @readonly @label("版本")
  current: string @readonly
  thumbnailUrl: string @readonly
  reference: ImageReference
  variants: ImageVariant[]
  variantCount: int @readonly
  variantSummary: string @readonly @label("状态图")
  variantNames: string @readonly
}

type ImageVariant {
  state: string @readonly
  file: string @readonly
  name: string @readonly
  mime: string @readonly
  bytes: int @readonly
  thumbnailUrl: string @readonly
  reference: ImageReference
}

type ImageReference {
  assetId: string @readonly
  revisionId: string @readonly
  file: string @readonly
}

view workbench {
  title "2D 美术素材"
  layout catalog
  inspector false
  default {
    collection images
    list grid
    mode preview
  }
  collection images {
    path images
    label "2D 美术素材"
    title name
    subtitle [assetName, version]
    search [name, assetName, kind, mime, version, variantNames]
    columns [assetName, version, variantSummary, mime, bytes]
    list [detail, grid]
    modes [{"id": "preview", "label": "预览"}]
    thumbnail {"src": "thumbnailUrl", "alt": "name"}
    pageSize 48
    filters [{"id": "current", "label": "版本范围", "default": ["current"], "options": [{"value": "current", "label": "当前版本"}, {"value": "historical", "label": "历史版本"}]}, {"id": "assetId", "label": "所属素材", "options": {"path": "assetOptions", "value": "id", "label": "name"}}, {"id": "kind", "label": "素材类型", "options": {"path": "kindOptions", "value": "id", "label": "name"}}]
  }
}
