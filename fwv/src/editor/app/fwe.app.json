{
  "id": "fwv-workbench",
  "title": "FWV · 2D 美术编辑器",
  "workspace": ".",
  "extensions": [{"path": "./extension.cjs", "client": ["./gallery2d-panel.js", "./skeleton2d-panel.js", "./workbench.js"]}],
  "domains": [
    {
      "extends": "./catalog.fwe",
      "actions": {"toolbar": [], "save": false, "undo": false, "redo": false, "add": false, "duplicate": false, "delete": false, "new": false},
      "workbench": {
        "editor": {"configs": {"gallery2d": "./gallery2d.ui.json"}}
      },
      "inspector": {"forms": {"images:preview": {"groups": [{"fields": [{"path": "reference", "label": false, "form": "fwv-image-preview"}]}]}}}
    },
    {
      "extends": "./authoring.fwe",
      "save": {"maxBodyBytes": 17825792},
      "actions": {"toolbar": ["undo", "redo", "save"], "save": true, "undo": true, "redo": true, "add": false, "duplicate": false, "delete": false, "new": false},
      "workbench": {
        "editor": {"configs": {"skeleton2d": "./skeleton2d.ui.json"}}
      },
      "inspector": {"forms": {"skeleton2dDrafts:edit": {"groups": [{"fields": [{"path": "data", "label": false, "form": "fwv-skeleton2d"}]}]}}}
    }
  ],
  "navigation": {"workspaces": [{"id": "fwv", "label": "2D 美术", "sections": [
    {"id": "gallery2d", "label": "2D 美术素材", "domainId": "fwv-catalog", "collectionId": "images", "hideFile": true},
    {"id": "skeleton2d", "label": "2D 骨骼动画", "domainId": "fwv-authoring", "collectionId": "skeleton2dDrafts", "hideFile": true}
  ]}]},
  "labels": {"save": "保存草稿", "undo": "撤销编辑", "redo": "重做编辑"}
}
