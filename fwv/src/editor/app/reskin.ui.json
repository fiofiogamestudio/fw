{
  "root": "root",
  "fields": {
    "workflows": {
      "label": "换皮方案",
      "control": "select"
    },
    "templateAssetId": {
      "schemaPath": "reskinDrafts[].data.templateAssetId",
      "control": "select"
    },
    "templateRevisionId": {
      "schemaPath": "reskinDrafts[].data.templateRevisionId",
      "control": "select"
    },
    "name": {
      "schemaPath": "reskinDrafts[].data.name",
      "placeholder": "例如：森林游侠"
    },
    "mode": {
      "schemaPath": "reskinDrafts[].data.mode",
      "optionLabels": {
        "local": "本地 Agent",
        "api": "API 服务"
      },
      "default": "local"
    },
    "brief": {
      "schemaPath": "reskinDrafts[].data.brief",
      "placeholder": "例如：森林游侠，保留原姿态与身体比例，服装使用墨绿与浅金配色。",
      "rows": 4
    },
    "style": {
      "schemaPath": "reskinDrafts[].data.style",
      "placeholder": "例如：2D 手绘，清晰深色描边，柔和顶光。",
      "rows": 3
    },
    "preserveAlpha": {
      "schemaPath": "reskinDrafts[].data.preserveAlpha",
      "default": true
    },
    "partSelected": {
      "type": "boolean",
      "label": "选择此部件"
    },
    "partNote": {
      "type": "string",
      "control": "textarea",
      "label": "部件要求",
      "maxLength": 300,
      "placeholder": "可选：材质、形状、配色要求",
      "rows": 2
    },
    "instructions": {
      "type": "string",
      "control": "textarea",
      "label": "给当前对话的本地任务指令",
      "readOnly": true
    },
    "scale": {
      "schemaPath": "spineDrafts[].data.transform.scale"
    },
    "offsetX": {
      "schemaPath": "spineDrafts[].data.transform.offsetX"
    },
    "offsetY": {
      "schemaPath": "spineDrafts[].data.transform.offsetY"
    },
    "rotation": {
      "schemaPath": "spineDrafts[].data.transform.rotation"
    },
    "flipX": {
      "schemaPath": "spineDrafts[].data.transform.flipX"
    },
    "adjustPart": {
      "type": "string",
      "control": "select",
      "label": "需要校准的部件"
    }
  },
  "templates": {
    "root": {
      "type": "stack",
      "ref": "root",
      "children": [
        {
          "type": "toolbar",
          "children": [
            {
              "type": "field",
              "ref": "workflows",
              "field": "workflows",
              "testId": "fwv-reskin-workflows",
              "attrs": {
                "disabled": {
                  "$path": "blocked",
                  "default": false
                }
              }
            },
            {
              "type": "button",
              "ref": "newPlan",
              "text": "新建方案",
              "testId": "fwv-reskin-new",
              "attrs": {
                "disabled": {
                  "$path": "blocked",
                  "default": false
                }
              }
            },
            {
              "type": "button",
              "ref": "service",
              "text": "模型设置",
              "testId": "fwv-reskin-provider",
              "visible": {
                "$path": "apiMode"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": {
            "$path": "statusText",
            "default": ""
          },
          "ref": "status",
          "testId": "fwv-reskin-status",
          "attrs": {
            "role": "status",
            "data-error": {
              "$path": "statusError",
              "default": false
            }
          },
          "visible": {
            "$path": "statusText"
          },
          "tone": {
            "$if": [
              {
                "$path": "statusError",
                "default": false
              },
              "danger",
              "default"
            ]
          }
        },
        {
          "type": "slot",
          "ref": "content"
        }
      ],
      "testId": "fwv-reskin"
    },
    "empty": {
      "type": "card",
      "children": [
        {
          "type": "heading",
          "text": "先准备一个有动作的角色模板"
        },
        {
          "type": "text",
          "text": "导入 Spine 4.2 JSON、Atlas 和 PNG。"
        },
        {
          "type": "button",
          "ref": "importTemplate",
          "text": "导入 Spine 模板",
          "testId": "fwv-reskin-import-template",
          "attrs": {
            "disabled": {
              "$path": "editorBlocked",
              "default": false
            }
          }
        }
      ]
    },
    "create": {
      "type": "columns",
      "preset": "workspace",
      "children": [
        {
          "type": "stack",
          "children": [
            {
              "type": "slot",
              "ref": "previewHost"
            },
            {
              "type": "details",
              "ref": "parts-options",
              "testId": "fwv-reskin-parts-options",
              "children": [
                {
                  "type": "summary",
                  "text": "选择部件与单独要求"
                },
                {
                  "type": "slot",
                  "ref": "partHolder",
                  "children": [
                    {
                      "type": "text",
                      "text": "正在读取模板部件…"
                    }
                  ],
                  "testId": "fwv-reskin-template-parts"
                }
              ]
            }
          ]
        },
        {
          "type": "form",
          "ref": "form",
          "children": [
            {
              "type": "heading",
              "text": "新建换皮方案"
            },
            {
              "type": "field",
              "ref": "templateAssetId",
              "field": "templateAssetId",
              "testId": "fwv-reskin-template",
              "attrs": {
                "disabled": {
                  "$path": "editorBlocked",
                  "default": false
                }
              }
            },
            {
              "type": "field",
              "ref": "name",
              "field": "name",
              "testId": "fwv-reskin-name",
              "attrs": {
                "disabled": {
                  "$path": "editorBlocked",
                  "default": false
                }
              }
            },
            {
              "type": "field",
              "ref": "brief",
              "field": "brief",
              "testId": "fwv-reskin-brief",
              "attrs": {
                "disabled": {
                  "$path": "editorBlocked",
                  "default": false
                }
              }
            },
            {
              "type": "field",
              "ref": "mode",
              "field": "mode",
              "testId": "fwv-reskin-mode",
              "attrs": {
                "disabled": {
                  "$path": "editorBlocked",
                  "default": false
                }
              }
            },
            {
              "type": "button",
              "ref": "create",
              "text": "创建方案",
              "testId": "fwv-reskin-create",
              "attrs": {
                "type": "submit",
                "disabled": {
                  "$path": "createBlocked",
                  "default": false
                }
              },
              "tone": "primary"
            },
            {
              "type": "details",
              "ref": "options",
              "testId": "fwv-reskin-options",
              "children": [
                {
                  "type": "summary",
                  "text": "风格与更多选项"
                },
                {
                  "type": "field",
                  "ref": "style",
                  "field": "style",
                  "testId": "fwv-reskin-style",
                  "attrs": {
                    "disabled": {
                      "$path": "editorBlocked",
                      "default": false
                    }
                  }
                },
                {
                  "type": "field",
                  "ref": "templateRevisionId",
                  "field": "templateRevisionId",
                  "testId": "fwv-reskin-template-revision",
                  "attrs": {
                    "disabled": {
                      "$path": "editorBlocked",
                      "default": false
                    }
                  }
                },
                {
                  "type": "field",
                  "ref": "preserveAlpha",
                  "field": "preserveAlpha",
                  "testId": "fwv-reskin-preserve-alpha",
                  "attrs": {
                    "disabled": {
                      "$path": "editorBlocked",
                      "default": false
                    }
                  }
                },
                {
                  "type": "text",
                  "text": {
                    "$path": "modeText",
                    "default": ""
                  },
                  "ref": "modeNote",
                  "testId": "fwv-reskin-mode-note",
                  "visible": {
                    "$path": "modeText"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": {
                "$path": "templateWarnings",
                "default": ""
              },
              "ref": "warning",
              "testId": "fwv-reskin-template-warnings",
              "visible": {
                "$path": "templateWarnings"
              }
            }
          ],
          "preset": "compact"
        }
      ]
    },
    "parts": {
      "type": "stack",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "heading",
              "text": {
                "$path": "title"
              }
            },
            {
              "type": "badge",
              "ref": "countLabel",
              "testId": "fwv-reskin-part-count",
              "text": {
                "$path": "partCountText",
                "default": ""
              }
            }
          ]
        },
        {
          "type": "toolbar",
          "children": [
            {
              "type": "button",
              "ref": "selectAll",
              "text": "全选",
              "testId": "fwv-reskin-select-all-parts",
              "attrs": {
                "disabled": {
                  "$path": "editorBlocked",
                  "default": false
                }
              }
            },
            {
              "type": "button",
              "ref": "clear",
              "text": "清空选择",
              "testId": "fwv-reskin-clear-parts",
              "attrs": {
                "disabled": {
                  "$path": "editorBlocked",
                  "default": false
                }
              }
            }
          ]
        },
        {
          "type": "slot",
          "ref": "rows"
        },
        {
          "type": "text",
          "text": "此模板没有可换皮部件。",
          "visible": {
            "$path": "empty"
          }
        }
      ]
    },
    "part": {
      "type": "row",
      "children": [
        {
          "type": "field",
          "ref": "check",
          "field": "partSelected",
          "testId": "fwv-reskin-part",
          "value": {
            "$path": "selected"
          },
          "attrs": {
            "data-region-name": {
              "$path": "regionName"
            },
            "aria-label": {
              "$path": "selectionLabel"
            },
            "disabled": {
              "$path": "editorBlocked",
              "default": false
            }
          }
        },
        {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "text": {
                "$path": "regionName"
              }
            },
            {
              "type": "text",
              "text": {
                "$path": "description"
              }
            }
          ]
        },
        {
          "type": "field",
          "ref": "note",
          "field": "partNote",
          "testId": "fwv-reskin-part-note",
          "value": {
            "$path": "note"
          },
          "attrs": {
            "data-region-name": {
              "$path": "regionName"
            },
            "disabled": {
              "$path": "editorBlocked",
              "default": false
            }
          }
        }
      ]
    },
    "editor": {
      "type": "columns",
      "preset": "workspace",
      "children": [
        {
          "type": "stack",
          "children": [
            {
              "type": "slot",
              "ref": "previewHost",
              "testId": "fwv-reskin-character-preview"
            },
            {
              "type": "slot",
              "ref": "actionHost"
            },
            {
              "type": "slot",
              "ref": "localHost"
            },
            {
              "type": "details",
              "ref": "parts-options",
              "testId": "fwv-reskin-parts-options",
              "children": [
                {
                  "type": "summary",
                  "text": "选择部件与单独要求"
                },
                {
                  "type": "slot",
                  "ref": "partsHost"
                }
              ]
            },
            {
              "type": "details",
              "ref": "result-details",
              "testId": "fwv-reskin-result-details",
              "children": [
                {
                  "type": "summary",
                  "text": "部件图与检查记录"
                },
                {
                  "type": "slot",
                  "ref": "resultHost"
                }
              ],
              "attrs": {
                "open": {
                  "$path": "hasProblem",
                  "default": false
                }
              }
            },
            {
              "type": "details",
              "ref": "history",
              "testId": "fwv-reskin-history",
              "children": [
                {
                  "type": "summary",
                  "text": "历史版本"
                },
                {
                  "type": "slot",
                  "ref": "historyHost"
                }
              ]
            }
          ]
        },
        {
          "type": "card",
          "children": [
            {
              "type": "heading",
              "text": "换皮要求"
            },
            {
              "type": "field",
              "ref": "brief",
              "field": "brief",
              "testId": "fwv-reskin-brief",
              "attrs": {
                "disabled": {
                  "$path": "editorBlocked",
                  "default": false
                }
              }
            },
            {
              "type": "field",
              "ref": "mode",
              "field": "mode",
              "testId": "fwv-reskin-mode",
              "attrs": {
                "disabled": {
                  "$path": "editorBlocked",
                  "default": false
                }
              }
            },
            {
              "type": "button",
              "ref": "generate",
              "text": {
                "$path": "generateText",
                "default": "统一生成所选部件"
              },
              "testId": "fwv-reskin-generate",
              "attrs": {
                "disabled": {
                  "$path": "generateBlocked",
                  "default": false
                }
              },
              "tone": "primary"
            },
            {
              "type": "text",
              "text": {
                "$path": "providerText",
                "default": ""
              },
              "ref": "providerLabel",
              "tone": "muted"
            },
            {
              "type": "details",
              "ref": "options",
              "testId": "fwv-reskin-options",
              "children": [
                {
                  "type": "summary",
                  "text": "风格与更多选项"
                },
                {
                  "type": "field",
                  "ref": "style",
                  "field": "style",
                  "testId": "fwv-reskin-style",
                  "attrs": {
                    "disabled": {
                      "$path": "editorBlocked",
                      "default": false
                    }
                  }
                },
                {
                  "type": "text",
                  "text": {
                    "$path": "templateLabel"
                  }
                },
                {
                  "type": "text",
                  "text": {
                    "$path": "modeText",
                    "default": ""
                  },
                  "ref": "modeNote",
                  "testId": "fwv-reskin-mode-note",
                  "visible": {
                    "$path": "modeText"
                  }
                },
                {
                  "type": "button",
                  "ref": "save",
                  "text": "保存方案要求",
                  "testId": "fwv-reskin-update",
                  "attrs": {
                    "disabled": {
                      "$path": "editorBlocked",
                      "default": false
                    }
                  }
                }
              ]
            },
            {
              "type": "slot",
              "ref": "adjustmentHost"
            }
          ]
        }
      ]
    },
    "previewMissing": {
      "type": "text",
      "text": "动画预览组件尚未加载，可通过「检查全部动作」打开候选。"
    },
    "sheet": {
      "type": "stack",
      "children": [
        {
          "type": "heading",
          "text": {
            "$path": "label"
          }
        },
        {
          "type": "image",
          "visible": {
            "$path": "url"
          },
          "testId": {
            "$path": "testId"
          },
          "attrs": {
            "src": {
              "$path": "url"
            },
            "alt": {
              "$path": "label"
            }
          }
        },
        {
          "type": "text",
          "text": {
            "$path": "placeholder"
          },
          "visible": {
            "$path": "missing"
          }
        }
      ]
    },
    "local": {
      "type": "details",
      "ref": "task",
      "children": [
        {
          "type": "summary",
          "text": {
            "$if": [
              {
                "$path": "actionable"
              },
              "交给当前对话执行",
              "查看执行记录"
            ]
          }
        },
        {
          "type": "text",
          "text": {
            "$path": "description"
          }
        },
        {
          "type": "button",
          "ref": "copy",
          "text": "复制任务指令",
          "testId": "fwv-reskin-local-copy",
          "visible": {
            "$path": "actionable"
          },
          "attrs": {
            "data-readonly-action": "true"
          },
          "tone": "primary"
        },
        {
          "type": "details",
          "children": [
            {
              "type": "summary",
              "text": "查看任务指令"
            },
            {
              "type": "field",
              "ref": "instructions",
              "field": "instructions",
              "testId": "fwv-reskin-local-instructions",
              "value": {
                "$path": "instructions"
              },
              "visible": {
                "$path": "actionable"
              },
              "attrs": {
                "data-readonly-action": "true"
              }
            }
          ],
          "attrs": {
            "open": {
              "$path": "revealInstructions",
              "default": false
            }
          },
          "visible": {
            "$path": "actionable"
          }
        },
        {
          "type": "text",
          "text": {
            "$path": "worker"
          },
          "visible": {
            "$path": "worker"
          }
        },
        {
          "type": "details",
          "children": [
            {
              "type": "summary",
              "text": "理解与风险记录"
            },
            {
              "type": "text",
              "text": {
                "$path": "summary"
              },
              "visible": {
                "$path": "summary"
              }
            },
            {
              "type": "list",
              "items": {
                "$path": "partNotes"
              },
              "template": "note"
            },
            {
              "type": "heading",
              "text": "需要检查的风险"
            },
            {
              "type": "list",
              "items": {
                "$path": "risks"
              },
              "template": "note"
            }
          ],
          "visible": {
            "$path": "hasAnalysis"
          },
          "testId": "fwv-reskin-local-analysis"
        }
      ],
      "testId": "fwv-reskin-local-task",
      "attrs": {
        "open": {
          "$path": "actionable"
        },
        "data-workflow-id": {
          "$path": "workflowId"
        },
        "data-attempt-id": {
          "$path": "attemptId"
        }
      }
    },
    "note": {
      "type": "text",
      "text": {
        "$path": "message"
      }
    },
    "result": {
      "type": "stack",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "heading",
              "text": "部件布局与生成结果"
            },
            {
              "type": "badge",
              "text": {
                "$path": "status"
              },
              "testId": "fwv-reskin-attempt-status"
            },
            {
              "type": "badge",
              "text": {
                "$path": "mode"
              }
            },
            {
              "type": "badge",
              "text": {
                "$path": "alpha"
              }
            }
          ]
        },
        {
          "type": "columns",
          "children": [
            {
              "type": "slot",
              "ref": "sourceSheet"
            },
            {
              "type": "slot",
              "ref": "generatedSheet"
            }
          ]
        },
        {
          "type": "text",
          "text": {
            "$path": "error"
          },
          "visible": {
            "$path": "error"
          }
        },
        {
          "type": "details",
          "children": [
            {
              "type": "summary",
              "text": "技术检查详情"
            },
            {
              "type": "list",
              "items": {
                "$path": "checks"
              },
              "template": "note"
            }
          ],
          "visible": {
            "$path": "hasChecks"
          },
          "testId": "fwv-reskin-part-checks"
        },
        {
          "type": "text",
          "text": {
            "$path": "uncertainty"
          },
          "visible": {
            "$path": "uncertainty"
          }
        },
        {
          "type": "details",
          "children": [
            {
              "type": "summary",
              "text": "查看本次实际提示词"
            },
            {
              "type": "pre",
              "text": {
                "$path": "prompt"
              }
            }
          ],
          "visible": {
            "$path": "prompt"
          }
        },
        {
          "type": "text",
          "text": {
            "$path": "progressText",
            "default": ""
          },
          "ref": "progress",
          "testId": "fwv-reskin-progress",
          "visible": {
            "$path": "progressText"
          }
        }
      ]
    },
    "attempt": {
      "type": "button",
      "ref": "attempt",
      "text": "",
      "testId": "fwv-reskin-attempt",
      "attrs": {
        "data-attempt-id": {
          "$path": "id"
        },
        "aria-pressed": {
          "$path": "selected"
        },
        "disabled": {
          "$path": "editorBlocked",
          "default": false
        }
      },
      "children": [
        {
          "type": "heading",
          "text": {
            "$path": "title"
          }
        },
        {
          "type": "badge",
          "text": {
            "$path": "status"
          }
        },
        {
          "type": "text",
          "text": {
            "$path": "description"
          }
        }
      ]
    },
    "historyEmpty": {
      "type": "text",
      "text": "方案尚未调用模型。第一次生成后会保留候选记录。"
    },
    "actions": {
      "type": "toolbar",
      "children": [
        {
          "type": "button",
          "ref": "cancel",
          "text": "取消本次等待",
          "testId": "fwv-reskin-cancel",
          "visible": {
            "$path": "running"
          },
          "attrs": {
            "disabled": {
              "$path": "cancelBlocked",
              "default": false
            }
          }
        },
        {
          "type": "button",
          "ref": "query",
          "text": "刷新状态",
          "testId": "fwv-reskin-query",
          "attrs": {
            "data-readonly-action": "true"
          },
          "visible": {
            "$path": "needsProgress"
          }
        },
        {
          "type": "button",
          "ref": "selectCandidate",
