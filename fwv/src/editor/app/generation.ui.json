    "message031": "已保存到素材库。",
    "message032": "图片已生成，等待保存。",
    "message033": "任务 {v0}{v1}",
    "message034": "\n请求 ",
    "message035": "待确认请求 {v0}",
    "message036": "已等待 {v0} 分 {v1} 秒",
    "message037": "发起于 {v0}",
    "message038": "暂时无法读取任务状态：{v0}。可点击查询；不会自动重新生成。",
    "message039": "参考图版本不再可用，请重新选择。",
