    "message041": "请求已提交。",
    "message042": "提交结果尚未确认：{v0}。请查询本次任务。",
    "message043": "请求被拒绝，尚未创建生成任务：{v0}",
    "message044": "模型服务暂不可用：{v0}",
    "keyStatusInitial": "尚未读取配置",
    "capabilityNoteInitial": "",
    "jobBadgeInitial": "尚未开始",
    "jobMetaInitial": "",
    "elapsedInitial": "",
    "referenceDescription": "{name}\n{width} × {height} px",
    "providerReady": "模型服务 · {model}",
    "providerMissing": "模型服务 · 需要配置",
    "referenceSelected": "参考图 · {name}",
    "referenceEmpty": "参考图（可选）"
  }
}
