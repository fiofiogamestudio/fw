id fwv-authoring
title "2D 美术编辑"
source "fwv-authoring:."
file "authoring.json"

data AuthoringDocument {
  schemaVersion: int = 1 @readonly @range(1, 1)
  projectId: string @readonly
  skeleton2dDrafts?: Skeleton2dDraft[] = [] @items(min=0, max=200)
}

type Skeleton2dDraft {
  id: string @key @readonly @label("角色草稿")
  name?: string @readonly @label("角色")
  revisionLabel?: string @readonly @label("版本")
  textureCount?: int @readonly @label("贴图数量")
  thumbnailUrl?: string @readonly
  data: Skeleton2dParameters @label("2D 骨骼编辑")
}

type Skeleton2dParameters {
  assetId?: string @label("角色")
  revisionId?: string @label("基础版本")
  document?: Skeleton2dDocument @label("骨骼与动画")
  skin?: string @label("皮肤")
  animation?: string @label("动画")
  bone?: string @label("骨骼树")
  slot?: string @label("部件插槽")
  attachment?: string @label("绑定附件")
  channel?: string @label("关键帧轨道") @enum("translate", "rotate", "scale")
  frameIndex?: int @label("关键帧") @range(-1, 100000)
  time?: number @label("时间 / 秒") @range(0, 86400) @step("any")
  speed?: number @label("播放速度") @range(0.1, 4) @step("any")
  showBones?: bool @label("显示骨骼")
  frame?: Skeleton2dKeyframe @label("关键帧参数")
  attachmentTransform?: Skeleton2dAttachment @label("附件变换")
  meshEditing?: Skeleton2dMeshEditing @label("网格权重编辑")
}

type Skeleton2dDocument {
  format?: string @readonly
  schemaVersion?: int @readonly
  coordinateSystem?: string @readonly
  bones?: Skeleton2dBone[] @label("骨骼")
  slots?: Skeleton2dSlot[] @label("插槽")
  skins?: Skeleton2dSkin[] @label("皮肤")
  animations?: json @label("动画轨道")
  animationDurations?: json
  loopAnimations?: json
  skinAnimations?: json
  skinBones?: json
  skinSockets?: json
  textures?: json
  events?: json
  clipBounds?: json
  bounds?: json
  lines?: json
  metadata?: json
}

type Skeleton2dBone {
  name?: string @label("骨骼名称")
  parent?: string @label("父骨骼")
  x?: number @label("骨骼 X") @step("any")
  y?: number @label("骨骼 Y") @step("any")
  rotation?: number @label("骨骼旋转 / 度") @step("any")
  scaleX?: number @label("骨骼水平缩放") @step("any")
  scaleY?: number @label("骨骼垂直缩放") @step("any")
  rotationLimit?: json
  length?: number
}

type Skeleton2dSlot {
  name?: string @label("插槽名称")
  bone?: string @label("绑定骨骼")
  attachment?: string @label("默认附件")
}

type Skeleton2dSkin {
  name?: string @label("皮肤名称")
  attachments?: json @label("部件附件")
}

type Skeleton2dAttachment {
  x?: number @label("部件 X") @step("any")
  y?: number @label("部件 Y") @step("any")
  rotation?: number @label("部件旋转 / 度") @step("any")
  scaleX?: number @label("部件水平缩放") @step("any")
  scaleY?: number @label("部件垂直缩放") @step("any")
  width?: number @label("部件宽度") @range(0.000001, 1000000) @step("any")
  height?: number @label("部件高度") @range(0.000001, 1000000) @step("any")
}

type Skeleton2dMeshEditing {
  vertex?: int @label("网格顶点 / 从 0 开始") @range(0, 4095)
  influences?: json @label("顶点影响：bone / x / y / weight")
  uvs?: json @label("UV 坐标 / 左上原点")
  triangles?: json @label("三角形顶点索引")
  vertices?: json @label("全部 Spine 加权顶点")
}

type Skeleton2dKeyframe {
  time?: number @label("关键帧时间 / 秒") @range(0, 86400) @step("any")
  x?: number @label("关键帧 X") @step("any")
  y?: number @label("关键帧 Y") @step("any")
  value?: number @label("关键帧旋转 / 度") @step("any")
  curve?: string @label("插值") @enum("linear", "stepped")
}

view workbench {
  title "2D 骨骼动画"
  layout catalog
  inspector false
  default {
    collection skeleton2dDrafts
    list detail
    mode edit
  }
  collection skeleton2dDrafts {
    path skeleton2dDrafts
    label "2D 骨骼动画"
    title name
    subtitle [revisionLabel, textureCount]
    search [name, id]
    columns [name, revisionLabel, textureCount]
    list [detail, grid]
    modes [{"id": "edit", "label": "编辑"}]
    thumbnail {"src": "thumbnailUrl", "alt": "name"}
    pageSize 48
  }
}
