{
  "id": "fwv-ui-capture",
  "title": "FWV · UI 截图审阅",
  "workspace": ".",
  "extensions": [{"path": "./extension.cjs", "client": ["./review-logic.js", "./review-panel.js"]}],
  "domains": [{
    "extends": "./catalog.fwe",
    "actions": {"toolbar": ["undo", "redo", "save"], "save": true, "undo": true, "redo": true, "add": false, "duplicate": false, "delete": false, "new": false},
    "workbench": {"editor": {"configs": {"preview": "./preview.ui.json", "coverage": "./coverage.ui.json"}}},
    "inspector": {"forms": {
      "screenshots:review": {"groups": [
        {"fields": [{"path": "reference", "label": false, "form": "fwv-ui-screenshot"}]},
        {"fields": [
          {"path": "reviewStatus", "label": false, "form": "fwv-ui-decision"},
          {"path": "reviewNote", "label": "备注", "type": "textarea", "rows": 2, "required": false}
        ]}
      ]},
      "coverage:inspect": {"groups": [{"fields": [{"path": "id", "label": false, "form": "fwv-ui-coverage"}]}]}
    }}
  }],
  "navigation": {"workspaces": [{"id": "ui-capture", "label": "UI 审阅", "sections": [
    {"id": "screenshots", "label": "截图图库", "domainId": "fwv-ui-capture", "collectionId": "screenshots", "hideFile": true},
    {"id": "coverage", "label": "覆盖与缺口", "domainId": "fwv-ui-capture", "collectionId": "coverage", "hideFile": true}
  ]}]},
  "labels": {"save": "保存审阅", "undo": "撤销", "redo": "重做"}
}
