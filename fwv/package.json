{
  "name": "fwv",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Reusable visual tools for 2D assets, skeletal animation and UI capture review, built on FWE.",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "fwv": "bin/fwv.mjs"
  },
  "exports": {
    ".": "./src/core/project.mjs",
    "./image": "./src/image/processor.mjs",
    "./editor": "./src/editor/server.mjs",
    "./skeleton2d": "./src/skeleton2d/document.mjs",
    "./skeleton2d/application": "./src/skeleton2d/application.mjs",
    "./skeleton2d/sample": "./src/skeleton2d/sample.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "editor": "node tools/start-editor.mjs",
    "ui": "node ui/cli.mjs",
    "demo": "node tools/create-demo.mjs .local/demo",
    "test:gallery2d-browser": "node tools/test-gallery2d-browser.mjs",
    "test:skeleton2d-browser": "node tools/test-skeleton2d-browser.mjs"
  },
  "dependencies": {
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10"
  }
}
