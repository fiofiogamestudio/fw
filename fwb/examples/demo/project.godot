; FWB demo: the build command assembles runtime/addons/fwb into an isolated copy.
config_version=5

[application]
config/name="FWB 星港补给站"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="fwb-demo"

[autoload]
FwbPlatform="*res://addons/fwb/platform.gd"

[display]
window/size/viewport_width=1100
window/size/viewport_height=740
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.047, 0.09, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true
