config_version=5

[application]
config/name="FWB Save Flow"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="fwb-save-flow-example"

[autoload]
FwbPlatform="*res://addons/fwb/platform.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.05, 0.065, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true
